# Replace with your deployed backend URL (or set REACT_APP_API_URL in your host's env settings)
REACT_APP_API_URL=https://api.your-domain.com/api
GENERATE_SOURCEMAP=false
# Browser tracing: set to your collector's public OTLP/HTTP URL to enable (sample 10% of sessions)
REACT_APP_OTEL_ENDPOINT=
REACT_APP_OTEL_SAMPLE_RATE=0.1
