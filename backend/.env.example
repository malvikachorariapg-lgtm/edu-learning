NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017/imarticus-lms
JWT_SECRET=change-me-to-a-long-random-string
REDIS_HOST=localhost
REDIS_PORT=6379
FRONTEND_URL=http://localhost:3000

# Razorpay (test keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Vertex AI (Gemini) for document summaries — single-line service account JSON
FI_VERTEX_CREDENTIALS_JSON='{"type":"service_account", ...}'
FI_VERTEX_PROJECT=
FI_VERTEX_LOCATION=global
FI_REASONING_MODEL=gemini-2.5-flash
FI_AI_ENABLED=true
FI_VISION_ENABLED=true

# Logging / OpenTelemetry (unset the endpoint to disable telemetry)
LOG_LEVEL=info
OTEL_SERVICE_NAME=edu-learning-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
